<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.6</version>
        <relativePath/> <!-- lookup parent from repository -->
    </parent>
    <groupId>com.reguai</groupId>
    <artifactId>reguai</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>ReguAI</name>
    <description>ReguAI- Regulatory Reporting and AI Assistant Platform</description>

    <modules>
        <module>reguai-common</module>
        <module>reguai-business</module>
        <module>reguai-interfaces</module>
        <module>reguai-system</module>
        <module>reguai-app</module>
    </modules>
<!--    进行统一版本管理-->
    <properties>
        <java.version>17</java.version>
        <mybatis-plus.version>3.5.12</mybatis-plus.version>
        <lombok.version>1.18.40</lombok.version>
    </properties>
    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>com.reguai</groupId>
                <artifactId>reguai-common</artifactId>
                <version>${project.version}</version>
            </dependency>

            <dependency>
                <groupId>com.reguai</groupId>
                <artifactId>reguai-business</artifactId>
                <version>${project.version}</version>
            </dependency>

            <dependency>
                <groupId>com.reguai</groupId>
                <artifactId>reguai-system</artifactId>
                <version>${project.version}</version>
            </dependency>

            <dependency>
                <groupId>com.reguai</groupId>
                <artifactId>reguai-interfaces</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.baomidou</groupId>
                <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
                <version>${mybatis-plus.version}</version>
            </dependency>
            <dependency>
                <groupId>org.projectlombok</groupId>
                <artifactId>lombok</artifactId>
                <version>${lombok.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

</project>
